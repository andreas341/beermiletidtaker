{
  "rules": {
    ".read": true,
    ".write": "auth != null && auth.uid === 'LIM_INN_ADMIN_UID'",
    "race": {
      ".validate": "newData.hasChildren(['started','elapsed']) && newData.child('started').isBoolean() && newData.child('elapsed').isNumber() && newData.child('elapsed').val() >= 0"
    },
    "participants": {
      "$id": {
        ".validate": "newData.hasChildren(['id','bib','name']) && newData.child('id').isString() && newData.child('bib').isNumber() && newData.child('name').isString() && newData.child('name').val().length > 0"
      }
    }
  }
}
